# Copy to .env in this same folder and fill in real values. Do not commit .env.

# Public hostname or IP of the TURN server. Used only as the coturn "realm" label;
# does not need DNS if you'd rather point the frontend at a bare IP.
TURN_REALM=turn.africau.co.zw

# Long-term credential shared by every client (baked into the frontend JS bundle,
# so it is not secret from end users — total-quota/user-quota and the denied-peer-ip
# ranges in docker-compose.yml are what actually limit abuse). Rotate periodically.
TURN_USERNAME=mindful-turn
TURN_PASSWORD=change-me-to-a-long-random-value

# UDP relay port range. Keep it narrow so the firewall rule stays small — 40 ports
# is enough for a few dozen concurrent relayed calls (2 ports per relayed leg).
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
