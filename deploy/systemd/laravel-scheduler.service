[Unit]
Description=Mindful AU Laravel Scheduler
After=network.target redis-server.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=5
WorkingDirectory=/var/www/mindful-au-main/backend
ExecStart=/usr/bin/php artisan schedule:work
KillSignal=SIGTERM
TimeoutStopSec=60
PrivateTmp=true

[Install]
WantedBy=multi-user.target
