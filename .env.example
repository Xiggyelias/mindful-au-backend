APP_NAME="Mindful AU Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
API_EXPOSE_ERROR_DETAILS=true
FORCE_HTTPS=false

FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Log database queries slower than this many milliseconds (0 = disabled).
DB_SLOW_QUERY_MS=1000
# Log API requests (api/*) slower than this many milliseconds.
SLOW_REQUEST_LOG_MS=1000

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer
DB_WAIT_FOR_CONNECTION=false
DB_WAIT_MAX_ATTEMPTS=30
DB_WAIT_SLEEP_SECONDS=2
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_CERT=
MYSQL_ATTR_SSL_KEY=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

CACHE_STORE=file
# Production / scale-out: prefer Redis for shared cache, faster reads, and optional session storage.
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_CONNECTION=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys — use same public key in clients (optional; SPA fetches /api/push/vapid-public-key).
WEB_PUSH_ENABLED=false
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email notifications. Keep privacy-safe mode on for counseling-related notifications.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_PRIVACY_SAFE=true
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173,127.0.0.1,localhost
SANCTUM_TOKEN_PREFIX=
SANCTUM_TOKEN_EXPIRATION=120

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8000/api/auth/google/callback
INSTITUTION_EMAIL_DOMAINS=africau.edu

AUTH_REQUIRE_GOOGLE_FOR_STUDENTS=true
# Backward-compatible alias used by older deployments.
AUTH_REQUIRE_GOOGLE_FOR_STUDENT_STAFF=true
AUTH_AUTO_PROVISION_STUDENTS=true
OAUTH_LOGIN_TICKET_TTL_SECONDS=120

ADMIN_SESSION_TIMEOUT_MINUTES=30
SESSIONS_LIGHTWEIGHT_CACHE_SECONDS=5
# Throttle anonymous chat session `updated_at` bumps (faster polling + fewer DB writes; TTL is still 24h).
ANONYMOUS_SESSION_ACTIVITY_TOUCH_SECONDS=60
# Anonymous session TTL (in hours). Default: 24 hours. Extended values: 48, 168 (7 days), 720 (30 days).
# Shorter TTLs enforce privacy (sessions auto-retire), longer TTLs improve UX (prevent mid-use expiration).
ANONYMOUS_SESSION_TTL_HOURS=48
# Session keep-alive: Controls throttle window for touch endpoint (in seconds).
# Set lower for more responsive keep-alive, higher to reduce DB writes. Min: 15, Default: 60.
SESSION_TOUCH_THROTTLE_SECONDS=60
APPOINTMENT_BOOKING_LOCK_TTL_SECONDS=15
APPOINTMENT_BOOKING_LOCK_WAIT_SECONDS=3
TRUSTED_PROXIES=

API_RATE_LIMIT_AUTH_PER_MINUTE=240
API_RATE_LIMIT_GUEST_PER_MINUTE=60
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_REGISTER_RATE_LIMIT_PER_MINUTE=5
OAUTH_TICKET_EXCHANGE_RATE_LIMIT_PER_MINUTE=30
MESSAGES_READ_RATE_LIMIT_PER_MINUTE=120
MESSAGES_WRITE_RATE_LIMIT_PER_MINUTE=60
PRESENCE_RATE_LIMIT_PER_MINUTE=30
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_UPLOAD_MAX_FILE_SIZE_KB=5120
CHAT_UPLOAD_DIRECTORY=uploads/chat_files
CHAT_UPLOAD_SIGNED_URL_MINUTES=1440
# Set to 's3' in production to store chat attachments in S3 (or any S3-compatible store).
CHAT_UPLOAD_DISK=local

# AWS / S3-compatible object storage (required when CHAT_UPLOAD_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mindful
# Public URL base for the bucket (e.g. CDN or custom domain). Used by Storage::url() for public files.
AWS_URL=https://storage.africau.co.zw/mindful
# S3-compatible endpoint (MinIO, DigitalOcean Spaces, Backblaze B2, etc.)
AWS_ENDPOINT=https://storage-s3.africau.co.zw
# Required for path-style S3-compatible stores (MinIO and most self-hosted).
AWS_USE_PATH_STYLE_ENDPOINT=true
# S3 CORS: to enable in-browser blob downloads (rather than window.open fallback), add a CORS rule
# on the bucket allowing GET from your frontend origin:
#   AllowedOrigins: ["https://your-frontend-domain.com"]
#   AllowedMethods: ["GET"]
#   AllowedHeaders: ["*"]
#   ExposeHeaders: ["Content-Disposition"]
# Without this, downloads fall back to window.open (still works, just can't control the filename).
AI_READ_RATE_LIMIT_PER_MINUTE=60
DIAGNOSTICS_SUBMIT_RATE_LIMIT_PER_MINUTE=20

SECURITY_X_FRAME_OPTIONS=SAMEORIGIN
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
SECURITY_CONTENT_SECURITY_POLICY="default-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
SECURITY_FORCE_HSTS=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
HEALTH_MIN_DISK_FREE_PERCENT=5
HEALTH_DISK_CACHE_SECONDS=15
LARAVEL_OPTIMIZE_ON_BOOT=false
PREVENT_LAZY_LOADING=false
AUTO_BACKUP_ENCRYPT=true
AUTO_BACKUP_MAX_ROWS=10000
AUTO_BACKUP_RETENTION_DAYS=14

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://127.0.0.1:5173
OPENROUTER_SITE_NAME="Mindful AU Local"
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_CORE_MODEL=qwen/qwen3-next-80b-a3b-thinking
OPENROUTER_HEAVY_ANALYSIS_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_SPEED_MODEL=liquid/lfm-2.5-1.2b-thinking:free

AI_PROVIDER_TIMEOUT_SECONDS=8
AI_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
# Keep disabled unless legal/privacy review allows sending counseling transcripts to external AI providers.
AI_EXTERNAL_DIAGNOSTICS_ENABLED=false
AI_ADMIN_ML_STUDENT_LIMIT=2000
